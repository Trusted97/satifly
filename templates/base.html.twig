<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}Satifly{% endblock %}</title>

    <link rel="icon" href="{{ asset('images/favicon.ico') }}" type="image/x-icon">
    <link href="{{ asset('css/bootstrap.min.css') }}" rel="stylesheet">

    <style>
        :root {
            color-scheme: light;
            --app-bg: #f5f7fb;
            --app-surface: rgba(255, 255, 255, 0.88);
            --app-surface-strong: #ffffff;
            --app-border: rgba(15, 23, 42, 0.08);
            --app-text: #0f172a;
            --app-muted: #64748b;
            --app-primary: #2563eb;
            --app-primary-dark: #1d4ed8;
            --app-success-bg: #ecfdf5;
            --app-success-fg: #166534;
            --app-warning-bg: #fffbeb;
            --app-warning-fg: #92400e;
            --app-danger-bg: #fef2f2;
            --app-danger-fg: #991b1b;
            --app-info-bg: #eff6ff;
            --app-info-fg: #1d4ed8;
            --app-shadow: 0 18px 50px rgba(15, 23, 42, 0.08);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, rgba(37, 99, 235, 0.11), transparent 32%),
                radial-gradient(circle at top right, rgba(14, 165, 233, 0.10), transparent 28%),
                linear-gradient(180deg, #f8fbff 0%, #f5f7fb 48%, #edf2f7 100%);
            color: var(--app-text);
        }

        a {
            color: var(--app-primary);
        }

        a:hover {
            color: var(--app-primary-dark);
        }

        .app-shell {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .app-skip-link {
            position: absolute;
            left: 50%;
            transform: translateY(-120%);
            padding: .75rem 1rem;
            border-radius: .75rem;
            background: #fff;
            color: var(--app-text);
            box-shadow: var(--app-shadow);
            z-index: 1050;
        }

        .app-skip-link:focus {
            transform: translateY(0);
        }

        .app-header {
            border-bottom: 1px solid var(--app-border);
            backdrop-filter: blur(18px);
            background: rgba(255, 255, 255, 0.72);
        }

        .app-brand-title {
            font-weight: 600;
            letter-spacing: -0.03em;
            color: var(--app-text);
        }

        .app-brand-subtitle {
            color: var(--app-muted);
        }

        .app-page {
            flex: 1;
            width: 100%;
            padding: 2rem 0 3rem;
        }

        .app-card {
            border: 1px solid var(--app-border);
            border-radius: 1.15rem;
            box-shadow: var(--app-shadow);
            overflow: hidden;
        }

        .card {
            border-color: var(--app-border);
            border-radius: 1rem;
            box-shadow: var(--app-shadow);
        }

        .card-header {
            background: rgba(248, 250, 252, 0.95);
            border-bottom: 1px solid var(--app-border);
        }

        .btn {
            border-radius: .85rem;
            font-weight: 500;
        }

        .btn-primary {
            --bs-btn-bg: var(--app-primary);
            --bs-btn-border-color: var(--app-primary);
            --bs-btn-hover-bg: var(--app-primary-dark);
            --bs-btn-hover-border-color: var(--app-primary-dark);
        }

        .btn-outline-primary {
            --bs-btn-color: var(--app-primary);
            --bs-btn-border-color: rgba(37, 99, 235, 0.28);
            --bs-btn-hover-bg: var(--app-primary);
            --bs-btn-hover-border-color: var(--app-primary);
        }

        .btn-outline-danger {
            --bs-btn-color: #b91c1c;
            --bs-btn-border-color: rgba(185, 28, 28, 0.25);
        }

        .form-control,
        .form-select {
            border-radius: .85rem;
            border-color: rgba(100, 116, 139, 0.25);
            box-shadow: none;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: rgba(37, 99, 235, 0.5);
            box-shadow: 0 0 0 .25rem rgba(37, 99, 235, 0.12);
        }

        .alert {
            border-radius: 1rem;
            border: 1px solid var(--app-border);
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        }

        .alert-success {
            background: var(--app-success-bg);
            color: var(--app-success-fg);
        }

        .alert-warning {
            background: var(--app-warning-bg);
            color: var(--app-warning-fg);
        }

        .alert-danger {
            background: var(--app-danger-bg);
            color: var(--app-danger-fg);
        }

        .alert-info {
            background: var(--app-info-bg);
            color: var(--app-info-fg);
        }

        .table {
            margin-bottom: 0;
        }

        .table thead th {
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--app-muted);
            border-bottom-color: rgba(100, 116, 139, 0.18);
        }

        .table tbody tr {
            transition: background-color .18s ease, transform .18s ease;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(37, 99, 235, 0.04);
        }

        .app-footer {
            color: var(--app-muted);
        }

        @media (max-width: 767.98px) {
            .app-page {
                padding-top: 1.25rem;
            }

            .app-header .container,
            .app-page .container {
                padding-left: 1rem;
                padding-right: 1rem;
            }
        }
    </style>
</head>

<body>
<div class="app-shell">
<a class="app-skip-link" href="#main-content">Skip to content</a>

{% block header %}
    <header class="app-header sticky-top">
        <div class="container py-3">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                <div>
                    <a href="{{ path('index') }}" class="text-decoration-none">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill text-bg-primary px-3 py-2">Satifly</span>
                            <h1 class="h4 app-brand-title mb-0">Private Composer Registry</h1>
                        </div>
                    </a>
                    <p class="app-brand-subtitle mb-0 mt-1">Symfony-powered registry management with a fast, focused UI.</p>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <a href="{{ path('admin') }}" class="btn btn-outline-primary">
                        Admin dashboard
                    </a>
                    <a href="{{ path('index') }}" class="btn btn-primary">
                        Registry home
                    </a>
                    {% if isAuthEnabled is defined and isAuthEnabled and is_granted('IS_AUTHENTICATED_FULLY') %}
                        <a href="{{ path('logout') }}" class="btn btn-outline-danger">
                            Logout
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>
{% endblock %}

{% set flash_messages = app.flashes %}
{% if flash_messages is not empty %}
    <div class="container pt-3">
        {% for label, messages in flash_messages %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    <div class="d-flex align-items-start gap-2">
                        <div class="fw-semibold text-uppercase small mt-1">
                            {% if label == 'success' %}
                                Success
                            {% elseif label == 'danger' %}
                                Error
                            {% elseif label == 'warning' %}
                                Warning
                            {% else %}
                                Info
                            {% endif %}
                        </div>
                        <div class="flex-grow-1">{{ message }}</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}

<main id="main-content" class="app-page">
    <div class="container">
    {% block content %}{% endblock %}
    </div>
</main>

<footer class="app-footer border-top">
    <div class="container py-3 small d-flex flex-column flex-sm-row justify-content-between gap-2">
        <span>Satifly</span>
        <span>Built with Symfony, FrankenPHP, and Caddy.</span>
    </div>
</footer>

<script src="{{ asset('js/bootstrap.min.js') }}"></script>
{% block javascript %}{% endblock %}
</div>
</body>
</html>
