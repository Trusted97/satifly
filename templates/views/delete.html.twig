{% extends "base.html.twig" %}

{% block title %}Delete repository{% endblock %}

{% block content %}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0">
                <div class="card-body p-4 p-lg-5">
                    <span class="badge rounded-pill text-bg-danger mb-3">Danger zone</span>
                    <h2 class="h3 fw-semibold mb-3">Delete this repository?</h2>
                    <p class="text-muted mb-4">
                        This will permanently remove <strong>{{ repository.name ?: repository.url }}</strong> from the registry configuration.
                    </p>

                    {{ form_start(form, {
                        action: path('repository_delete', {'repository': repository.id }),
                        method: 'DELETE',
                        attr: {'onsubmit': 'return confirm("Are you sure?");'}
                    }) }}
                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <button class="btn btn-danger btn-lg">Delete repository</button>
                            <a href="{{ path('admin') }}" class="btn btn-outline-secondary btn-lg">Cancel</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
