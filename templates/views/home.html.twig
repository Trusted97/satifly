{% extends "base.html.twig" %}

{% block title %}Dashboard{% endblock %}

{% block content %}
    <section class="mb-4">
        <div class="row g-3 align-items-stretch">
            <div class="col-12 col-lg-7">
                <div class="card h-100 border-0" style="background: linear-gradient(135deg, rgba(37, 99, 235, 0.98), rgba(14, 165, 233, 0.85)); color: #fff;">
                    <div class="card-body p-4 p-lg-5">
                        <div class="d-flex flex-column gap-3">
                            <span class="badge rounded-pill text-bg-light text-primary align-self-start">Admin dashboard</span>
                            <div>
                                <h2 class="display-6 fw-semibold mb-3">Manage repositories without losing the flow.</h2>
                                <p class="lead mb-0" style="max-width: 42rem;">
                                    Add repositories, import from composer.lock, trigger builds, and keep your private Composer registry tidy from one place.
                                </p>
                            </div>
                            <div class="d-flex flex-column flex-sm-row gap-2">
                                <a href="{{ path('repository_new') }}" class="btn btn-light btn-lg">
                                    Add repository
                                </a>
                                <a href="{{ path('repository_upload') }}" class="btn btn-outline-light btn-lg">
                                    Import composer.lock
                                </a>
                                <a href="{{ path('satis_config') }}" class="btn btn-outline-light btn-lg">
                                    Edit config
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="row g-3 h-100">
                    <div class="col-12">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase fw-semibold mb-2">Repositories</div>
                                <div class="display-5 fw-semibold mb-1">{{ repositories|length }}</div>
                                <div class="text-muted">Tracked sources in your registry.</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column flex-md-row gap-3 align-items-md-center justify-content-between">
                                <div>
                                    <div class="text-muted small text-uppercase fw-semibold mb-2">Next step</div>
                                    <h3 class="h5 mb-1">Keep your registry up to date</h3>
                                    <p class="mb-0 text-muted">Review the list below, then open the relevant repository to edit or remove it.</p>
                                </div>
                                <a href="{{ path('satis_build') }}" class="btn btn-primary">
                                    Build packages
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section>
        <div class="card">
            <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 py-3">
                <div>
                    <h3 class="h5 mb-1">Registered repositories</h3>
                    <p class="text-muted mb-0">Open a repository to review or edit its configuration.</p>
                </div>
                <span class="badge rounded-pill text-bg-primary px-3 py-2">{{ repositories|length }} total</span>
            </div>

            {% if repositories is empty %}
                <div class="card-body py-5">
                    <div class="text-center mx-auto" style="max-width: 34rem;">
                        <h4 class="h3 mb-3">No repositories yet</h4>
                        <p class="text-muted mb-4">
                            Start by adding a repository manually or import one from a composer.lock file. Once added, it will appear here for quick editing and build management.
                        </p>
                        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                            <a href="{{ path('repository_new') }}" class="btn btn-primary btn-lg">Add repository</a>
                            <a href="{{ path('repository_upload') }}" class="btn btn-outline-primary btn-lg">Import composer.lock</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                        <tr>
                            <th scope="col" style="width: 72px;">#</th>
                            <th scope="col">Repository URL</th>
                            <th scope="col">Repository Name</th>
                            <th scope="col" class="text-end" style="width: 160px;">Action</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for repository in repositories %}
                            <tr>
                                <td class="text-muted fw-semibold">{{ loop.index }}</td>
                                <td class="text-break">
                                    <a href="{{ repository.url }}" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                        {{ repository.url }}
                                    </a>
                                </td>
                                <td class="fw-medium">
                                    {{ repository.name ?: 'Unnamed repository' }}
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('repository_edit', {'repository': repository.id }) }}" class="btn btn-sm btn-outline-primary">
                                        View details
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
