{% extends "base.html.twig" %}

{% block title %}Composer repository unavailable{% endblock %}

{% block content %}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card border-0">
                <div class="card-body p-4 p-lg-5 text-center">
                    <span class="badge rounded-pill text-bg-warning mb-3">Unavailable</span>
                    <h2 class="h1 fw-semibold mb-3">No generated registry is available yet</h2>
                    <p class="lead text-muted mb-4">
                        Satifly could not find a generated <code>index.html</code> file in the public directory. Build the registry first, then return here to browse the generated Composer metadata.
                    </p>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <a href="{{ path('satis_build') }}" class="btn btn-primary btn-lg">
                            Build registry
                        </a>
                        <a href="{{ path('admin') }}" class="btn btn-outline-primary btn-lg">
                            Manage repositories
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
